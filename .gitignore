# Nothing from the ROM set is ever committed (AGENTS.md, rule 1)
/rom/
*.zip
/src/
/assets/
/build/
*.dat
*.lst
# (but MAME's cores' opcode lists, its own sources: tools/reference/mame)
!/tools/reference/mame/**/*.lst
*.wav
*.ppm
*.bmp
__pycache__/
/release/
# what a game run keeps
*.hiscore
*.state
*.log
